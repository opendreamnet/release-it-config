{
  "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
  "git": {
    "commitsPath": ".",
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}"
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false,
    "skipChecks": true
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "Features"
          },
          {
            "type": "fix",
            "section": "Bug Fixes"
          },
          {
            "type": "perf",
            "section": "Performance Improvements"
          },
          {
            "type": "revert",
            "hidden": true
          },
          {
            "type": "style",
            "section": "Style"
          },
          {
            "type": "refactor",
            "section": "Code Refactoring"
          },
          {
            "type": "chore",
            "section": "Chores"
          },
          {
            "type": "test",
            "section": "Tests"
          },
          {
            "type": "build",
            "hidden": true
          },
          {
            "type": "ci",
            "section": "Continuous Integration"
          }
        ]
      },
      "context": {
        "linkCompare": true
      },
      "commitsOpts": {
        "path": "."
      },
      "gitRawCommitsOpts": {
        "path": "."
      },
      "parserOpts": {
        "noteKeywords": ["BREAKING CHANGE", "BREAKING-CHANGE", "BREAKING CHANGES", "BREAKING-CHANGES"]
      }
    }
  }
}
